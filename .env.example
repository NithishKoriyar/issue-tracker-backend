# Copy to .env for local development:  cp .env.example .env
# On Railway, set these in the backend service's Variables tab instead.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local:   postgres://<user>:<password>@localhost:5432/issue_tracker
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/issue_tracker

# --- Auth ---
# Long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Seeded admin (used by npm run db:seed) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
